# OFFGRID Emergency Network - Environment Configuration

# Server Settings
PORT=3001
OFFGRID_ROOT=

# SMTP Email Configuration (Phase 1)
# Supports Gmail, Outlook, or custom SMTP relay (e.g. Amazon SES, SendGrid, Mailgun)
# For Port 465 use SMTP_SECURE=true; for Port 587/25 use SMTP_SECURE=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=OFFGRID Emergency Network
SMTP_FROM_EMAIL=

# SMS Gateway Configuration (Optional - Phase 6)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_PHONE=

# Background Notification Queue & Escalation Engine (Phase 4 & 5)
# If REDIS_URL is provided, queue can bridge to Redis; otherwise embedded SQLite queue is used.
REDIS_URL=
NOTIFICATION_WORKER_CONCURRENCY=5
ESCALATION_STAGE1_MINUTES=3
ESCALATION_STAGE2_MINUTES=7
ESCALATION_STAGE3_MINUTES=15
ESCALATION_STAGE4_MINUTES=30


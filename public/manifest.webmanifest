{
  "name": "OFFGRID — Emergency Response Network",
  "short_name": "OFFGRID",
  "description": "AI-assisted emergency coordination for citizens, responders, hospitals and disaster authorities.",
  "id": "/",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#0d1623",
  "theme_color": "#0d1623",
  "orientation": "any",
  "categories": ["productivity", "utilities", "medical", "government"],
  "icons": [
    {
      "src": "/icon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any maskable"
    }
  ],
  "shortcuts": [
    {
      "name": "Send SOS",
      "short_name": "SOS",
      "description": "Open the smart SOS reporting dialog",
      "url": "/?action=sos",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Incident register",
      "short_name": "Incidents",
      "description": "View and triage emergency reports",
      "url": "/incidents",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    },
    {
      "name": "Live map",
      "short_name": "Map",
      "description": "Open the live incident map",
      "url": "/map",
      "icons": [{ "src": "/icon.svg", "sizes": "any", "type": "image/svg+xml" }]
    }
  ]
}
